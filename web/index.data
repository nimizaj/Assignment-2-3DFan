#version 300 es

/**
 * FanFragment.glsl
 *
 * ES 3.0 fragment shader for the touch-events triangle demo.
 * Simply outputs the interpolated vertex colour as the fragment colour.
 */

precision mediump float;
in vec3 VarColor;
out vec4 FragColor;

void main() {
    FragColor = vec4(VarColor, 1.0);
}#version 300 es
layout(location = 0) in vec3 VertexPosition;
layout(location = 1) in float Shade;

uniform mat4 MODELVIEWPROJECTIONMATRIX;
uniform vec3 PARTCOLOR;

out vec3 VarColor;

void main() {
    gl_Position = MODELVIEWPROJECTIONMATRIX * vec4(VertexPosition, 1.0);
    VarColor = PARTCOLOR * Shade;
}